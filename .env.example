# Environment Configuration for Marine Oil Spill System

# Backend API
PORT=8000
HOST=0.0.0.0
ENV=production
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
BASE_URL=https://sagar-netra-backend.onrender.com

# Supabase PostgreSQL Database (PostgreSQL + PostGIS)
# Example Supabase URI: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.projectref.supabase.co:5432/postgres

# Live AIS Stream API Key (from AISstream.io)
# AISSTREAM_API_KEY=de5c8707bb4ff474749f531e11a09a6b1e850200

# Machine Learning Paths
MODEL_CHECKPOINT_PATH=ml/checkpoints/best_model.pth

# Forcing Data Storage Path
FORCING_DATA_DIR=data/ocean
